rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isTeacher() {
      return isSignedIn() && getProfile(request.auth.uid).role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getProfile(request.auth.uid).role == 'student';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth == null || 
                                       isOwner(userId) || 
                                       userId == 'mock-teacher-fais' ||
                                       (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if true;
      
      match /questions/{questionId} {
        allow read, write: if true;
      }
    }

    // Results
    match /results/{resultId} {
      allow read, write: if true;
    }

    // Templates
    match /templates/{templateId} {
      allow read, write: if true;
    }
  }
}
